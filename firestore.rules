rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función helper para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función helper para verificar roles de admin
    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // SPEC-01: campos de sesión que AuthService escribe en el propio users/{uid}
    // durante login/logout/heartbeat (ver core/services/auth.service.ts).
    // No incluye role/active/activeUntil/maxSessions/salary/document/emergencyContact
    // ni ningún otro campo sensible.
    function isSelfSessionUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let allowedFields = ['sessions', 'activeSessionsCount', 'hasActiveSession', 'fcmToken'];
      return affectedKeys.hasOnly(allowedFields);
    }

    // SPEC-01: auto-reparación histórica de maxSessions ausente
    // (ver AuthService.ensureUserDocument) — solo permite fijarlo en 1,
    // nunca a otro valor, así que no sirve para escalar el límite de sesiones.
    function isSelfMaxSessionsHeal() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(['maxSessions']) && request.resource.data.maxSessions == 1;
    }

    function isSelfUpdate(userId) {
      return isAuthenticated() && request.auth.uid == userId &&
             (isSelfSessionUpdate() || isSelfMaxSessionsHeal());
    }

    // Reglas para usuarios
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || isSelfUpdate(userId);
      allow delete: if isAdmin();
    }
    
    // Reglas para parámetros
    match /parameters/{parameterId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Reglas para huéspedes
    match /guests/{guestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Reglas para productos
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Reglas para habitaciones
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Reglas para tareas de housekeeping
    match /housekeepingTasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // SPEC-12: reservas — escritura centralizada por completo en Cloud
    // Functions (crearReserva, confirmarReserva, cancelarReserva,
    // registrarCheckIn, registrarCheckOut — Specs 05-08). Confirmado contra
    // el código real que updateBooking/deleteBooking/markAsNoShow no tienen
    // ningún caller en la UI (código muerto) — no queda ningún camino
    // legítimo de escritura directa de cliente. Las Functions usan el Admin
    // SDK, que no está sujeto a estas reglas.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // SPEC-12: cuentas de huésped — escritura centralizada por completo en
    // Cloud Functions (agregarCargoCuenta, agregarPagoCuenta, cerrarCuenta —
    // Spec 09; la creación ahora la hace registrarCheckIn — Spec 07).
    // Confirmado que GuestAccountService.createAccountFromBooking/
    // removeCharge y el delete del repositorio no tienen ningún caller real.
    match /guestAccounts/{accountId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }
    
    // Reglas para movimientos de inventario
    match /inventoryMovements/{movementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false; // No se pueden eliminar movimientos
    }
    
    // Reglas para gastos
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Reglas para cajas registradoras
    match /cashRegisters/{cashRegisterId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Reglas para transacciones (unificadas: gastos, depósitos, retiros, ventas, pagos)
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // SPEC-12: ventas — creación centralizada por completo en
    // registrarVentaPOS (Spec 11). No se encontró ningún otro caller de
    // creación/edición directa de sales en la UI. `delete` se deja como
    // estaba (isAdmin) — no forma parte de ninguna Spec, sin evidencia de
    // que sea código muerto o vivo, no se tocó.
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // SPEC-12: facturas — emisión/cancelación centralizadas por completo en
    // emitirFactura/cancelarFactura (Spec 10). El método genérico
    // InvoiceService.createInvoice no tiene ningún caller real (código
    // muerto) — no queda ningún camino legítimo de escritura directa.
    // `delete` se deja como estaba (isAdmin) — fuera de alcance de la Spec.
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create, update: if false;
      allow delete: if isAdmin();
    }
    
    // Reglas para notificaciones
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Reglas para permisos de roles
    match /rolePermissions/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
