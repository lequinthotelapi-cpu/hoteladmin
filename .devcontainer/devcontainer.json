{
  "name": "Angular 16 Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "angular-dev",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "ms-vscode.vscode-typescript-next",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-json",
        "amazonwebservices.amazon-q-vscode",
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "typescript.preferences.importModuleSpecifier": "relative"
      }
    }
  },
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": {
      "label": "Angular Dev Server",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install && ./.devcontainer/install-claude.sh",
  "postStartCommand": "git config --global http.sslVerify false && git config --global user.name 'lequinthotelapi-cpu' && git config --global user.email 'tu_email@ejemplo.com' && ./.devcontainer/install-claude.sh",
  "remoteUser": "root",
  "mounts": [
    "source=${localWorkspaceFolder}/.vscode,target=/workspace/.vscode,type=bind,consistency=cached"
  ]
}
