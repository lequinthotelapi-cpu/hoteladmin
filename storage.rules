rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Reglas para avatares de usuarios
    match /users/avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Reglas para fotos de huéspedes
    match /guests/photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Reglas para fotos de productos
    match /products/photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Reglas para comprobantes de gastos
    match /expenses/receipts/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
